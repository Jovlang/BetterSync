{
  "name": "bettersync",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run check && npm test && npm run build",
    "test:integration": "node --import tsx --test tests/*.integration.ts",
    "benchmark:chunks": "node --import tsx tests/chunk-benchmark.ts",
    "benchmark:download": "node --import tsx tests/download-benchmark.ts",
    "benchmark:hash": "node --import tsx tests/hash-benchmark.ts",
    "benchmark:e2ee:codec": "node --import tsx tests/encryption-benchmark.ts",
    "benchmark:e2ee:sync": "node --import tsx tests/sync-benchmark.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "license": "GPL-3.0-only"
}
